{
  "name": "04 - Disparador de Mensagens WhatsApp (EvoGO)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "node-schedule-1m",
      "name": "Cron 1min (Disparador)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/envios?status=eq.agendado&agendado_para=lte.now()&select=id,mensagem_completa,oferta_id,grupo_id,ofertas(id,titulo_original,link_afiliado,imagem_url,preco_por),grupos(id,nome_grupo,whatsapp_group_id,instancias(nome))&limit=3",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            }
          ]
        }
      },
      "id": "node-fetch-ready-envios",
      "name": "Buscar Envios Prontos (PostgREST)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "jsCode": "const envios = $input.first().json;\nconst enviosList = Array.isArray(envios) ? envios : (envios && envios.id ? [envios] : []);\n\nconst out = [];\n\nfor (const envio of enviosList) {\n  const oferta = envio.ofertas || {};\n  const grupo = envio.grupos || {};\n  const whatsappGroupId = grupo.whatsapp_group_id || '120363024847999999@g.us';\n  const imagemUrl = oferta.imagem_url || 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=800';\n  const linkAfiliado = oferta.link_afiliado || 'https://www.amazon.com.br';\n  const caption = envio.mensagem_completa || `🔥 ${oferta.titulo_original}\\n\\n🛒 Compre aqui: ${linkAfiliado}`;\n  \n  out.push({\n    json: {\n      envio_id: envio.id,\n      grupo_id: envio.grupo_id,\n      payload: {\n        number: whatsappGroupId,\n        url: linkAfiliado,\n        text: caption,\n        title: \" \",\n        description: \"\",\n        imgUrl: imagemUrl,\n        delay: 1200\n      }\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "node-prepare-link-preview-payload",
      "name": "Preparar Payload Link Preview",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 300]
    },
    {
      "parameters": {
        "url": "={{ ($env.EVOGO_API_URL || 'http://api:8080') + '/send/link' }}",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "d195a2f6-ca05-4f2e-a2f0-fa63d1de30d6"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node-send-evogo-link-preview",
      "name": "Disparar Link Preview (EvoGO)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/envios?id=eq.{{ $('Preparar Payload Link Preview').item.json.envio_id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'enviado', enviado_em: new Date().toISOString() }) }}"
      },
      "id": "node-update-envio-enviado",
      "name": "Atualizar Status do Envio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 300]
    }
  ],
  "connections": {
    "Cron 1min (Disparador)": {
      "main": [
        [
          {
            "node": "Buscar Envios Prontos (PostgREST)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Envios Prontos (PostgREST)": {
      "main": [
        [
          {
            "node": "Preparar Payload Link Preview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Payload Link Preview": {
      "main": [
        [
          {
            "node": "Disparar Link Preview (EvoGO)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Disparar Link Preview (EvoGO)": {
      "main": [
        [
          {
            "node": "Atualizar Status do Envio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
