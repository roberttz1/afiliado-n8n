{
  "name": "03 - Agendador de Fila de Envios (Slots & Throttle)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "node-schedule-2m",
      "name": "Cron 2min (Fila de Agendamento)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/ofertas?status=eq.aprovada&order=criado_em.asc&limit=5",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            }
          ]
        }
      },
      "id": "node-fetch-aprovadas",
      "name": "Buscar Ofertas Aprovadas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/grupos?status=eq.ativo",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            }
          ]
        }
      },
      "id": "node-fetch-grupos-ativos",
      "name": "Buscar Grupos Ativos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 300]
    },
    {
      "parameters": {
        "jsCode": "const ofertas = $('Buscar Ofertas Aprovadas').first().json || [];\nconst grupos = $input.first().json || [];\n\nconst ofertasList = Array.isArray(ofertas) ? ofertas : (ofertas.id ? [ofertas] : []);\nconst gruposList = Array.isArray(grupos) ? grupos : (grupos.id ? [grupos] : []);\n\nif (!ofertasList.length || !gruposList.length) {\n  return [];\n}\n\nconst enviosToInsert = [];\nlet slotBaseTime = new Date();\n\n// Ajustar se fora do horário comercial (08h às 22h BRT)\nconst hourBRT = (slotBaseTime.getUTCHours() - 3 + 24) % 24;\nif (hourBRT < 8) {\n  slotBaseTime.setUTCHours(11, 5, 0, 0); // 08:05 BRT\n} else if (hourBRT >= 22) {\n  slotBaseTime.setDate(slotBaseTime.getDate() + 1);\n  slotBaseTime.setUTCHours(11, 5, 0, 0); // 08:05 BRT amanhã\n}\n\nfor (let i = 0; i < ofertasList.length; i++) {\n  const oferta = ofertasList[i];\n  \n  for (const grupo of gruposList) {\n    if (grupo.nicho === (oferta.categoria || 'tenis') || grupo.nicho === 'tenis') {\n      \n      const minInterval = 5 + Math.floor(Math.random() * 5); // 5 a 9 min\n      const jitterSeconds = Math.floor(Math.random() * 60) - 30; // -30s a +30s\n      const slotTimestamp = new Date(slotBaseTime.getTime() + ((i * minInterval) * 60000) + (jitterSeconds * 1000));\n      \n      let msg = `*${oferta.titulo_gerado || '🔥 OFERTA IMPERDÍVEL!'}*\\n\\n`;\n      msg += `${oferta.titulo_original}\\n\\n`;\n      if (oferta.preco_de && oferta.preco_de > oferta.preco_por) {\n        msg += `De ~R$ ${parseFloat(oferta.preco_de).toFixed(2).replace('.', ',')}~\\n`;\n      }\n      msg += `Por apenas: *R$ ${parseFloat(oferta.preco_por).toFixed(2).replace('.', ',')}* 🔥\\n`;\n      if (oferta.cupom && oferta.cupom.trim().length > 0) {\n        msg += `🎟️ Cupom: *${oferta.cupom.toUpperCase()}*\\n`;\n      }\n      msg += `\\n🛒 Compre aqui: ${oferta.link_afiliado}\\n\\n`;\n      msg += `⚡ _Oferta por tempo limitado!_`;\n      \n      enviosToInsert.push({\n        json: {\n          oferta_id: oferta.id,\n          grupo_id: grupo.id,\n          instancia_id: grupo.instancia_id || null,\n          mensagem_completa: msg,\n          agendado_para: slotTimestamp.toISOString(),\n          status: 'agendado'\n        }\n      });\n    }\n  }\n}\n\nreturn enviosToInsert;"
      },
      "id": "node-calcular-slots",
      "name": "Calcular Slots e Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/envios",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "node-insert-envio-postgrest",
      "name": "Agendar na Fila de Envios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/ofertas?id=eq.{{ $json.oferta_id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'enviada' }) }}"
      },
      "id": "node-patch-oferta-enviada",
      "name": "Marcar Oferta como Agendada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 300]
    }
  ],
  "connections": {
    "Cron 2min (Fila de Agendamento)": {
      "main": [
        [
          {
            "node": "Buscar Ofertas Aprovadas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Ofertas Aprovadas": {
      "main": [
        [
          {
            "node": "Buscar Grupos Ativos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Grupos Ativos": {
      "main": [
        [
          {
            "node": "Calcular Slots e Mensagem",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calcular Slots e Mensagem": {
      "main": [
        [
          {
            "node": "Agendar na Fila de Envios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agendar na Fila de Envios": {
      "main": [
        [
          {
            "node": "Marcar Oferta como Agendada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
