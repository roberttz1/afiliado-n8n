{
  "name": "05 - Monitor de Grupos e Rotação Automática",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evogo-group-events",
        "options": {}
      },
      "id": "node-webhook-evogo-events",
      "name": "Webhook Evento EvoGO",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 300],
      "webhookId": "evogo-group-events-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst event = body.event || body.type || 'group-participants-update';\nconst data = body.data || body;\n\nconst groupJid = data.groupJid || data.id || (data.group && data.group.id) || '';\nconst action = data.action || (data.participants && data.participants[0]?.action) || 'add';\n\nlet delta = 0;\nlet eventoSaude = 'membro_entrou';\n\nif (action === 'add' || action === 'join') {\n  delta = 1;\n  eventoSaude = 'membro_entrou';\n} else if (action === 'remove' || action === 'leave') {\n  delta = -1;\n  eventoSaude = 'membro_saiu';\n}\n\nreturn [{\n  json: {\n    group_jid: groupJid,\n    delta: delta,\n    evento_saude: eventoSaude\n  }\n}];"
      },
      "id": "node-parse-event",
      "name": "Processar Evento de Membro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/grupos?whatsapp_group_id=eq.{{ $json.group_jid }}&limit=1",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            }
          ]
        }
      },
      "id": "node-fetch-target-group",
      "name": "Buscar Grupo no Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 300]
    },
    {
      "parameters": {
        "jsCode": "const grupos = $input.first().json;\nconst grupo = Array.isArray(grupos) ? grupos[0] : grupos;\nconst parseData = $('Processar Evento de Membro').item?.json || { delta: 0, evento_saude: 'membro_entrou' };\n\nif (!grupo || !grupo.id) {\n  return [];\n}\n\nconst qtdAtual = parseInt(grupo.qtd_membros || 0, 10);\nconst novaQtd = Math.max(0, qtdAtual + parseData.delta);\nconst capacidade = parseInt(grupo.capacidade_maxima || 950, 10);\nconst atingiuLimite = novaQtd >= capacidade;\n\nreturn [{\n  json: {\n    grupo_id: grupo.id,\n    nicho: grupo.nicho || 'tenis',\n    numero_sequencial: grupo.numero_sequencial || 1,\n    nova_qtd: novaQtd,\n    atingiu_limite: atingiuLimite,\n    evento_saude: parseData.evento_saude\n  }\n}];"
      },
      "id": "node-calc-capacity",
      "name": "Calcular Nova Capacidade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/grupos?id=eq.{{ $json.grupo_id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ qtd_membros: $json.nova_qtd }) }}"
      },
      "id": "node-update-group-count",
      "name": "Atualizar Contagem de Membros",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/log_saude",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ grupo_id: $('Calcular Nova Capacidade').item.json.grupo_id, evento: $('Calcular Nova Capacidade').item.json.evento_saude }) }}"
      },
      "id": "node-insert-health-log",
      "name": "Registrar Log de Saúde",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2.2
          },
          "conditions": [
            {
              "id": "cond-full",
              "leftValue": "={{ $('Calcular Nova Capacidade').item.json.atingiu_limite }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-group-full",
      "name": "IF Grupo Cheio (>= 950)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/grupos?id=eq.{{ $('Calcular Nova Capacidade').item.json.grupo_id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'cheio' }) }}"
      },
      "id": "node-mark-group-full",
      "name": "Marcar Grupo como Cheio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1740, 220]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/grupos",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
