            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"nicho\": \"{{ $('Calcular Nova Capacidade').item.json.nicho }}\",\n  \"numero_sequencial\": {{ $('Calcular Nova Capacidade').item.json.numero_sequencial + 1 }},\n  \"nome_grupo\": \"🔥 Tênis Ofertas VIP #{{ $('Calcular Nova Capacidade').item.json.numero_sequencial + 1 }}\",\n  \"link_convite\": \"https://chat.whatsapp.com/sample-group-invite\",\n  \"status\": \"ativo\",\n  \"capacidade_maxima\": 950\n}"
      },
      "id": "node-insert-new-group",
      "name": "Cadastrar Novo Grupo Ativo (N+1)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1960, 220]
    }
  ],
