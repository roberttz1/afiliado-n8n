{
  "name": "02 - Validador e Copywriter IA (Claude Sonnet)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "node-schedule-2m",
      "name": "Cron 2min (Fila de Validação)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/ofertas?status=eq.pendente&order=criado_em.asc&limit=5",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-fetch-pendentes-postgrest",
      "name": "Buscar Ofertas Pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const row = item.json;\n  if (!row || !row.id) continue;\n  \n  const precoDe = parseFloat(row.preco_de || 0);\n  const precoPor = parseFloat(row.preco_por || 0);\n  const link = row.link_afiliado || \"\";\n  \n  let isValid = true;\n  let motivo = \"\";\n  \n  if (!link || link.trim().length < 10) {\n    isValid = false;\n    motivo = \"Link de afiliado ausente ou inválido\";\n  } else if (precoPor < 30 || precoPor > 600) {\n    isValid = false;\n    motivo = `Preço R$ ${precoPor} fora da faixa plausível (R$ 30 - 600)`;\n  } else if (precoDe > 0 && ((1 - precoPor / precoDe) * 100) < 20) {\n    isValid = false;\n    motivo = `Desconto abaixo de 20% (De: ${precoDe}, Por: ${precoPor})`;\n  }\n  \n  results.push({\n    json: {\n      ...row,\n      is_valid: isValid,\n      motivo_descarte: motivo\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "node-validar-regras",
      "name": "Validar Regras de Negócio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2.2
          },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $json.is_valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-valid",
      "name": "IF Oferta Válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 80,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Você é um copywriter brasileiro especialista em grupos VIP de WhatsApp de ofertas de tênis.\\nCrie um título ultra persuasivo de no máximo 8 palavras no estilo dos grupos mais lucrativos (ex: 'ESSE TA DADO DEMAIS 🔥', 'MENOR PREÇO HISTÓRICO ⚡', 'DESCONTO INSANO NA NIKE 🏃', 'QUASE DE GRAÇA HOJE 📦').\\n\\nProduto: {{ $json.titulo_original }}\\nPreço De: R$ {{ $json.preco_de }}\\nPreço Por: R$ {{ $json.preco_por }}\\n\\nRetorne APENAS o título gerado em uma linha, sem aspas, sem texto adicional.\"\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node-claude-api",
      "name": "Gerar Copy com Claude Sonnet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 220]
    },
    {
      "parameters": {
        "jsCode": "const claudeRes = $input.first().json;\nconst itemOrig = $('Validar Regras de Negócio').item?.json || {};\n\nlet tituloGerado = null;\ntry {\n  if (claudeRes.content && claudeRes.content[0] && claudeRes.content[0].text) {\n    tituloGerado = claudeRes.content[0].text.trim().replace(/^[\\\"']|[\\\"']$/g, '');\n  }\n} catch (e) {}\n\nif (!tituloGerado || tituloGerado.length < 5) {\n  const desc = itemOrig.desconto_pct ? `${Math.round(itemOrig.desconto_pct)}% OFF` : 'SUPER DESCONTO';\n  tituloGerado = `🔥 TÊNIS COM ${desc} — OFERTA RELÂMPAGO!`;\n}\n\nreturn [{\n  json: {\n    id: itemOrig.id,\n    titulo_gerado: tituloGerado,\n    status: \"aprovada\"\n  }\n}];"
      },
      "id": "node-extract-claude-res",
      "name": "Extrair Copy e Fallback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 220]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/ofertas?id=eq.{{ $json.id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'aprovada', titulo_gerado: $json.titulo_gerado }) }}"
      },
      "id": "node-patch-aprovada",
      "name": "Atualizar Oferta Aprovada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 220]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/ofertas?id=eq.{{ $json.id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'descartada', motivo_descarte: $json.motivo_descarte }) }}"
      },
      "id": "node-patch-descartada",
      "name": "Descartar Oferta Inválida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 420]
    }
  ],
  "connections": {
    "Cron 2min (Fila de Validação)": {
      "main": [
        [
