# ============================================================
# VARIÁVEIS DE AMBIENTE — TEMPLATE (EvoGO Stack)
# Copie para .env e preencha com seus valores reais
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
SUPABASE_DB_URL=postgresql://postgres:senha@host:5432/postgres

# --- Shopee Affiliate ---
SHOPEE_APP_ID=seu_app_id
SHOPEE_APP_SECRET=seu_app_secret
SHOPEE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# --- Lomadee (Netshoes/Centauro/ML) ---
LOMADEE_APP_TOKEN=seu_token_lomadee
LOMADEE_SOURCE_ID=seu_source_id

# --- Awin ---
AWIN_PUBLISHER_ID=seu_publisher_id
AWIN_API_TOKEN=seu_api_token

# --- Shein ---
SHEIN_AFFILIATE_MODE=manual
# Se usar Awin: SHEIN_AFFILIATE_MODE=awin

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- EvoGO (Evolution Go API) ---
EVOGO_API_URL=https://evogo.seudominio.com
EVOGO_API_KEY=sua_api_key_evogo

# --- Dashboard ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
NEXTAUTH_SECRET=gerar_um_secret_aleatorio_aqui
NEXTAUTH_URL=https://seudominio.com

# --- Domínio ---
DOMAIN=seudominio.com
REDIRECT_BASE_URL=https://seudominio.com

# --- Configurações de Negócio ---
DESCONTO_MINIMO=30
PRECO_MAX_TENIS=500
INTERVALO_ENVIO_MIN=5
INTERVALO_ENVIO_MAX=10
HORARIO_INICIO=8
HORARIO_FIM=22
MAX_MENSAGENS_HORA=20
CAPACIDADE_MAX_GRUPO=950
