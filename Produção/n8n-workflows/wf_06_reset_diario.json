{
  "name": "06 - Reset Diário e Manutenção",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "id": "node-schedule-midnight",
      "name": "Cron Meia-Noite BRT (03:00 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/instancias?status=neq.banido",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mensagens_hoje: 0, ultimo_reset_contagem: new Date().toISOString().split('T')[0] }) }}"
      },
      "id": "node-reset-instancias",
      "name": "Reset Mensagens Instâncias",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL || 'https://kwiaddydbjdofcyrqglq.supabase.co' }}/rest/v1/grupos?status=neq.arquivado",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.SUPABASE_SERVICE_KEY || $env.SUPABASE_ANON_KEY) }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ofertas_hoje: 0, ultimo_reset_ofertas: new Date().toISOString().split('T')[0] }) }}"
      },
      "id": "node-reset-grupos",
      "name": "Reset Ofertas Hoje Grupos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    status: 'success',\n    mensagem: 'Reset diário de contadores concluído com sucesso!',\n    data_execucao: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-log-status",
      "name": "Log Status Manutenção",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300]
    }
  ],
  "connections": {
    "Cron Meia-Noite BRT (03:00 UTC)": {
      "main": [
        [
          {
            "node": "Reset Mensagens Instâncias",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reset Mensagens Instâncias": {
      "main": [
        [
          {
            "node": "Reset Ofertas Hoje Grupos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reset Ofertas Hoje Grupos": {
      "main": [
        [
          {
            "node": "Log Status Manutenção",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
