          }
        ]
      ]
    },
    "Gerar Copy com Claude Sonnet": {
      "main": [
        [
          {
            "node": "Extrair Resposta Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extrair Resposta Claude": {
      "main": [
        [
          {
